<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing of Honoured is copied to the cloud or to a new device.
  The native session is encrypted with a Keystore key that never leaves this
  device, so a copy would be unreadable anyway; the web session lives in the
  WebView and is signed in again on a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
