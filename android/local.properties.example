# Copy to android/local.properties (gitignored). Values here override the
# repository-root .env for this machine only. Never commit real values.

sdk.dir=/Users/<you>/Library/Android/sdk

# Installed/Play package. This does not change the Kotlin source namespace.
ANDROID_APPLICATION_ID=com.honoured.app

# Web app the shell loads (https).
HONOURED_WEB_APP_URL=

# Public client configuration.
REVENUECAT_ANDROID_API_KEY=
# Leave empty for store builds (production entitlement honoured_plus).
REVENUECAT_ENTITLEMENT_ID=
GOOGLE_WEB_CLIENT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional upload-key overrides for bundleRelease. Normally sync-env.sh creates
# android/signing/signing.properties, so these may remain empty. CI can also
# provide them as environment variables.
HONOURED_UPLOAD_STORE_FILE=
HONOURED_UPLOAD_STORE_PASSWORD=
HONOURED_UPLOAD_KEY_ALIAS=
HONOURED_UPLOAD_KEY_PASSWORD=
