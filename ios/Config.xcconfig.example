// `//` starts a comment in xcconfig files, so the URL scheme separator
// must be built from this helper variable.
HONOURED_URL_SLASH = /

HONOURED_WEB_APP_URL = https:$(HONOURED_URL_SLASH)$(HONOURED_URL_SLASH)honour-your-word.lovable.app
REVENUECAT_IOS_API_KEY = 

// RevenueCat entitlement the shell checks. Empty keeps the production
// identifier honoured_plus. Set it only to test against an entitlement in
// your own RevenueCat project, and clear it before archiving for the store.
REVENUECAT_ENTITLEMENT_ID =

// Bundle identifier used for this machine's builds. Defaults to
// com.honoured.app when unset. Override it here while testing against a
// throwaway App ID so the production identifier stays in project.yml.
HONOURED_BUNDLE_ID = com.honoured.app

// Apple Developer Team ID used for code signing. Kept here (gitignored)
// so each developer signs with their own team and `xcodegen generate`
// cannot discard it.
DEVELOPMENT_TEAM =

// Supabase project for native HealthKit sync. The URL needs the same
// slash escaping as the web app URL above.
SUPABASE_URL =
SUPABASE_ANON_KEY =

// Google Sign-In public client IDs (see .env.example). The reversed iOS client
// ID is the callback URL scheme; sync-env.sh derives it.
GOOGLE_WEB_CLIENT_ID =
GOOGLE_IOS_CLIENT_ID =
GOOGLE_IOS_REVERSED_CLIENT_ID =
