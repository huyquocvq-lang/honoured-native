# Single source of truth for local, machine-specific configuration.
# Copy to .env and fill in. .env is gitignored; never commit real keys.
#
# After editing, run ./scripts/sync-env.sh to regenerate ios/Config.xcconfig.
# Android reads this file directly at Gradle configuration time.

# Web app hosted in the native WebView shells.
HONOURED_WEB_APP_URL=https://honour-your-word.lovable.app

# RevenueCat public SDK keys. Empty leaves billing disabled instead of crashing.
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=

# RevenueCat entitlement both shells check. Empty keeps the production
# identifier honoured_plus; set it only to test against another entitlement
# in your own RevenueCat project. The web app and the database always use
# honoured_plus, so a row is mirrored only under the production identifier.
REVENUECAT_ENTITLEMENT_ID=

# iOS signing. Overrides the production bundle id in ios/project.yml so a
# throwaway App ID can be used for testing without touching tracked files.
IOS_BUNDLE_ID=com.honoured.app
IOS_DEVELOPMENT_TEAM=

# Supabase project the native layer syncs HealthKit data to. Must be the same
# project the web app talks to, otherwise rows land under the wrong users.
# Empty leaves native sync disabled instead of crashing.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Sign-In (public OAuth client IDs, never a client secret).
# GOOGLE_WEB_CLIENT_ID is the Web application client: the audience of the ID
# token on both platforms (iOS serverClientID, Android serverClientId) and one
# of the client IDs Supabase's Google provider accepts.
# GOOGLE_IOS_CLIENT_ID is the iOS client for the signed bundle id; its reversed
# form is registered as the callback URL scheme by scripts/sync-env.sh.
# Android needs no Android client ID in the app, but Google Cloud must have an
# Android client for com.honoured.app with the SHA-1 of every signing key.
# Empty leaves the Google button hidden (capability configured: false).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
